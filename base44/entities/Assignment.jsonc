{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "max_points": {
      "type": "number",
      "default": 100
    },
    "type": {
      "type": "string",
      "enum": [
        "homework",
        "quiz",
        "project",
        "exam",
        "essay"
      ],
      "default": "homework"
    },
    "attachment_url": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "closed"
      ],
      "default": "active"
    }
  },
  "required": [
    "course_id",
    "title",
    "teacher_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "data.course_id": {
            "$in": [
              "{{user.data.enrolled_course_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}