{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "subject",
        "club",
        "sports",
        "arts",
        "science",
        "technology",
        "language",
        "general"
      ]
    },
    "admin_email": {
      "type": "string"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "school_id": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "admin_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_private": false
        },
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}