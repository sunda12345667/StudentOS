{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "subject",
        "club",
        "sports",
        "arts",
        "science",
        "technology",
        "language",
        "general"
      ]
    },
    "admin_email": {
      "type": "string"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "school_id": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "admin_email"
  ]
}