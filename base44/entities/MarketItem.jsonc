{
  "name": "MarketItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Downloadable file for digital products"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "textbook",
        "notes",
        "past_questions",
        "materials",
        "gadgets",
        "handouts",
        "course",
        "tutorial"
      ],
      "default": "textbook"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair"
      ],
      "default": "good"
    },
    "subject": {
      "type": "string"
    },
    "grade_level": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "sold",
        "reserved"
      ],
      "default": "available"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "is_digital": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "price",
    "seller_email",
    "seller_name",
    "category"
  ]
}