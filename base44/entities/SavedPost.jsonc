{
  "name": "SavedPost",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "post_content": {
      "type": "string"
    },
    "post_author_name": {
      "type": "string"
    },
    "post_author_avatar": {
      "type": "string"
    },
    "post_image_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_email",
    "post_id"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}