{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "bank": {
      "type": "string"
    },
    "bank_code": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "wallet_id": {
      "type": "string"
    },
    "paystack_transfer_code": {
      "type": "string"
    },
    "paystack_recipient_code": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "amount",
    "bank",
    "account_number"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}