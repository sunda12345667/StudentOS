{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "fund",
        "payment",
        "escrow_hold",
        "escrow_release",
        "withdrawal",
        "refund"
      ],
      "default": "fund"
    },
    "amount": {
      "type": "number"
    },
    "balance_before": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "counterparty_email": {
      "type": "string"
    },
    "counterparty_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ]
}