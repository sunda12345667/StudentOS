{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "purchase",
        "sale",
        "commission",
        "refund",
        "withdrawal",
        "escrow_hold",
        "escrow_release",
        "adjustment",
        "bonus",
        "freeze",
        "unfreeze"
      ],
      "default": "deposit"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "balance_type": {
      "type": "string",
      "enum": [
        "wallet_balance",
        "pending_earnings",
        "available_earnings"
      ],
      "default": "wallet_balance"
    },
    "balance_before": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "counterparty_email": {
      "type": "string"
    },
    "counterparty_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "reversed"
      ],
      "default": "completed"
    },
    "reversal_of": {
      "type": "string",
      "description": "ID of original transaction being reversed"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ]
}