{
  "name": "Reel",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin"
      ],
      "default": "student"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "share_count": {
      "type": "number",
      "default": 0
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "flagged",
        "suspended",
        "removed"
      ],
      "default": "approved"
    },
    "moderation_note": {
      "type": "string"
    },
    "moderated_by": {
      "type": "string"
    },
    "report_count": {
      "type": "number",
      "default": 0
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "author_email",
    "author_name",
    "video_url"
  ]
}