{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin",
        "parent"
      ],
      "default": "student"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "grade_level": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "xp_points": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "courses_enrolled": {
      "type": "number",
      "default": 0
    },
    "assignments_done": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ]
}