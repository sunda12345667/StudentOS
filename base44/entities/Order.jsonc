{
  "name": "Order",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "item_image": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "digital",
        "physical"
      ],
      "default": "digital"
    },
    "buyer_email": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "commission_rate": {
      "type": "number",
      "default": 10
    },
    "commission_amount": {
      "type": "number",
      "default": 0
    },
    "seller_payout": {
      "type": "number",
      "default": 0
    },
    "delivery_option": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery",
        "digital"
      ],
      "default": "digital"
    },
    "delivery_address": {
      "type": "string"
    },
    "tracking_info": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "processing",
        "shipped",
        "delivered",
        "completed",
        "cancelled",
        "refunded",
        "disputed"
      ],
      "default": "pending"
    },
    "escrow_released": {
      "type": "boolean",
      "default": false
    },
    "buyer_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "auto_release_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "refund_reason": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "buyer_email",
    "seller_email",
    "price"
  ]
}