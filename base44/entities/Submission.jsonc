{
  "name": "Submission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "grade": {
      "type": "number"
    },
    "max_points": {
      "type": "number"
    },
    "feedback": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "graded",
        "late",
        "missing"
      ],
      "default": "submitted"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "assignment_id",
    "student_email",
    "student_name"
  ]
}