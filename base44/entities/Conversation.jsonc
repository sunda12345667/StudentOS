{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_avatars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_message": {
      "type": "string"
    },
    "last_message_time": {
      "type": "string",
      "format": "date-time"
    },
    "last_sender": {
      "type": "string"
    }
  },
  "required": [
    "participants"
  ],
  "rls": {
    "create": {
      "data.participants": "{{user.email}}"
    },
    "read": {
      "data.participants": "{{user.email}}"
    },
    "update": {
      "data.participants": "{{user.email}}"
    },
    "delete": {
      "data.participants": "{{user.email}}"
    }
  }
}