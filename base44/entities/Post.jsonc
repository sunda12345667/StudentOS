{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "admin",
        "parent"
      ],
      "default": "student"
    },
    "school_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "grade_level": {
      "type": "string"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "share_count": {
      "type": "number",
      "default": 0
    },
    "community_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "school",
        "friends"
      ],
      "default": "public"
    }
  },
  "required": [
    "content",
    "author_email",
    "author_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.privacy": "public"
        },
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}