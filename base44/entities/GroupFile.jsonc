{
  "name": "GroupFile",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_size": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "name",
    "file_url",
    "uploaded_by"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.group_id": {
            "$in": [
              "{{user.data.member_group_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}