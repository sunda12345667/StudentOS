{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "Deposited funds \u2014 usable for purchases, ads, subscriptions. Cannot be withdrawn."
    },
    "pending_earnings": {
      "type": "number",
      "default": 0,
      "description": "Sales revenue held in escrow \u2014 not yet withdrawable."
    },
    "available_earnings": {
      "type": "number",
      "default": 0,
      "description": "Released earnings \u2014 withdrawable to bank."
    },
    "total_funded": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "total_withdrawn": {
      "type": "number",
      "default": 0
    },
    "is_frozen": {
      "type": "boolean",
      "default": false
    },
    "freeze_reason": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ]
}