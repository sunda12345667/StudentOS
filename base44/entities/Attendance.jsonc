{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "session_label": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "marked_by": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "late",
              "excused"
            ]
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "group_id",
    "session_label",
    "session_date",
    "marked_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.marked_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.records.email": "{{user.email}}"
        },
        {
          "data.marked_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.marked_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.marked_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}